# Local RewindSafe demo: PostgreSQL 16 from docker-compose.yml, on loopback.
DATABASE_URL=postgresql://rewindsafe:rewindsafe@127.0.0.1:5436/veeriq
REWINDSAFE_SESSION_SECRET=change-me-local-dev-only

# offline keeps ArmorIQ decisions simulated. Set live only with a registered
# ArmorIQ workspace and private credentials; live mode fails closed on errors.
REWINDSAFE_ENFORCEMENT=offline
ARMORIQ_API_KEY=
ARMORIQ_ENV=production
ARMORIQ_SESSION_MODE=sdk
ARMORIQ_USER_EMAIL=
ARMORIQ_MCP_NAME=rewindsafe-recovery
# Default timeout in seconds for ArmorIQ calls. The SDK fixes the enforce check at 10 s itself;
# a check that times out is refused (fail closed).
REWINDSAFE_ARMORIQ_TIMEOUT_S=15

# development (default) allows demo sign-in and simulated enforcement.
# production refuses to start without OIDC sign-in and live ArmorIQ enforcement.
REWINDSAFE_ENV=development

# Required to serve the MCP server over HTTP (stdio needs no token).
REWINDSAFE_MCP_TOKEN=

# Optional model provider: auto selects a configured provider; scripted is
# deterministic and appropriate for the local demo. Supported: auto, llm,
# scripted (see backend/rewindsafe/config.py for provider selection).
REWINDSAFE_PLANNER=scripted
REWINDSAFE_LLM_PROVIDER=auto
GROQ_API_KEY=
REWINDSAFE_GROQ_MODEL=openai/gpt-oss-120b
REWINDSAFE_GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
REWINDSAFE_ANTHROPIC_MODEL=claude-sonnet-5-5
REWINDSAFE_ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
REWINDSAFE_OPENAI_MODEL=gpt-5.5

REWINDSAFE_MAX_STEPS=20
REWINDSAFE_MAX_REPLANS=3
