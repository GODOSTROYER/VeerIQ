# Local mode runs real MCP tools with a local policy gate and deterministic agent.
# Live mode requires ArmorIQ credentials and fails closed on backend failures.
ARMORIQ_MODE=local
ARMORIQ_API_KEY=
ARMORIQ_USER_EMAIL=
# Optional live model: OpenAI-compatible Chat Completions endpoint.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
PORT=4310
